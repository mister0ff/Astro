      </div>
      <div class="search-modal-body">

        <!-- Etapa 1: escolher item -->
        <div id="donateStep1">
          <div class="sr-section-title" style="margin-top:0;">Escolha um item seu para doar</div>
          <div class="sr-grid" id="donateMyItems"></div>
          <div class="search-msg" id="donateMsg1" style="margin-top:0.8rem;"></div>

          <!-- Prévia do item escolhido, ANTES de escolher destinatário -->
          <div id="donatePreviewBox" style="display:none;margin-top:1rem;padding:0.9rem;background:rgba(10,2,2,0.6);border:1px solid rgba(248,113,113,0.25);border-radius:14px;">
            <div style="font-size:0.72rem;letter-spacing:1.4px;text-transform:uppercase;color:#fca5a5;font-weight:800;margin-bottom:0.6rem;">
              Item que você vai doar
            </div>
            <div style="display:flex;align-items:center;gap:0.9rem;">
              <div id="donatePreviewThumb" style="width:72px;height:72px;border-radius:12px;background:radial-gradient(circle at 30% 20%, #2a1414, #170808);box-shadow:inset 0 0 0 1px rgba(248,113,113,0.25);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;"></div>
              <div style="display:flex;flex-direction:column;gap:0.15rem;min-width:0;">
                <div id="donatePreviewName" style="color:#fee2e2;font-weight:800;font-size:1rem;letter-spacing:1px;text-transform:uppercase;">—</div>
                <div id="donatePreviewKind" style="color:#71717a;font-size:0.72rem;letter-spacing:1px;text-transform:uppercase;">—</div>
              </div>
            </div>
          </div>

          <div class="search-input-row" style="margin-top:1rem;">
            <input type="text" id="donateTargetNick" placeholder="Nick de quem vai receber..." maxlength="20" autocomplete="off" spellcheck="false">
            <button id="donateNextBtn" disabled>Continuar</button>
          </div>
        </div>

        <!-- Etapa 2: confirmar -->
        <div id="donateStep2" style="display:none;">
          <div class="sr-profile" style="margin-bottom:1rem;">
            <div class="sr-avatar" id="donateTargetAvatar">?</div>
            <div class="sr-info">
              <div class="nick" id="donateTargetNickLabel">—</div>
              <div class="stats">vai receber o item abaixo</div>
            </div>
          </div>
          <div class="sr-section-title" style="margin-top:0;">Item que será doado</div>
          <div class="sr-grid" id="donatePreviewItem" style="grid-template-columns:repeat(auto-fill,minmax(110px,1fr));max-width:140px;"></div>
          <div class="search-msg" id="donateMsg2" style="margin-top:1rem;"></div>
          <div style="display:flex;gap:0.6rem;margin-top:1rem;flex-wrap:wrap;">
            <button id="donateBackBtn" style="flex:1;color:#fca5a5;border:1px solid rgba(248,113,113,0.5);background:rgba(248,113,113,0.1);padding:0.8rem;border-radius:50px;font-weight:700;letter-spacing:1px;cursor:pointer;text-transform:uppercase;font-size:0.8rem;">Voltar</button>
            <button id="donateConfirmBtn" style="flex:2;color:#fff;border:none;padding:0.8rem;border-radius:50px;font-weight:700;letter-spacing:1px;cursor:pointer;text-transform:uppercase;font-size:0.8rem;background:linear-gradient(135deg,#b91c1c,#dc2626);box-shadow:0 6px 18px -4px #dc2626;">Confirmar Doação</button>
          </div>
        </div>

