  <!-- ===== POPUP DE PRESENTE RECEBIDO ===== -->
  <div class="gift-overlay" id="giftOverlay">
    <div class="gift-box">
      <div class="gift-confetti" id="giftConfetti"></div>
      <div class="gift-content">
        <div class="gift-title">Doação Recebida!</div>
        <div class="gift-sub" id="giftSub">alguém te enviou um presente</div>
        <div class="gift-from" id="giftFrom">De <strong>—</strong></div>
        <div class="gift-img-wrap">
          <img id="giftImg" src="" alt="">
        </div>
        <div class="gift-item-name" id="giftItemName">Item</div>
        <button class="gift-btn" id="giftBtn">Obrigado!</button>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

  <script>
    // ================== FIREBASE ==================
    const firebaseConfig = {
      apiKey: "AIzaSyCtXluQl2mtkehl9FICeJBPbP-_A3YRhzk",
      authDomain: "testgyyyy.firebaseapp.com",
      projectId: "testgyyyy",
      storageBucket: "testgyyyy.firebasestorage.app",
      messagingSenderId: "393006784345",
      appId: "1:393006784345:web:df958ca70ac79ccc603648",
      measurementId: "G-5RY35J0MQ6"
    };
    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db   = firebase.firestore();

    // ================== SOM ==================
    const clickSound = new Audio('https://cdn.discordapp.com/attachments/1462160007893356677/1560425835603689492/os_click.ogg');
    clickSound.preload = 'auto';
    clickSound.volume = 0.5;
    function playClick() {
      try { const s = clickSound.cloneNode(); s.volume = 0.5; s.play().catch(() => {}); } catch (e) {}
    }
    document.addEventListener('click', playClick, true);

    // ================== ASSETS ==================
    const STARTCAT_TAG_ICON = 'img/starcat.png';
    const FLORAL_TAG_ICON   = 'img/floral.png';

    // Link do pack — troque aqui
    const PACK_DOWNLOAD_URL = 'StarCat_Cosmetics.mcpack';

    // ================== CONTAGEM ONLINE ==================
    // Troque esse endpoint pela sua API real (ex: /api/online ou Firestore doc)
    // Se falhar, exibe "--" (não trava o site).
    async function fetchOnlineCount() {
      try {
        // Opção A: Firestore doc "status/online" → { count: 42 }
        const snap = await db.collection('status').doc('online').get();
        if (snap.exists && typeof snap.data().count === 'number') return snap.data().count;

        // Opção B: API externa (descomente e ajuste):
        // const r = await fetch('/api/online'); const j = await r.json(); return j.count;

        return null;
      } catch (e) {
        return null;
      }
    }
    async function updateOnlineBadge() {
      const el = document.getElementById('onlineNum');
      if (!el) return;
      const n = await fetchOnlineCount();
      el.textContent = (n === null || n === undefined) ? '--' : String(n);
    }
    updateOnlineBadge();
    setInterval(updateOnlineBadge, 30000);

    // ================== BOTÃO BAIXAR PACK ==================
    (function setupDownloadButton() {
      const btn = document.getElementById('downloadPackBtn');
      if (!btn) return;
      btn.addEventListener('click', () => {
        btn.classList.add('downloading');
        const a = document.createElement('a');
        a.href = PACK_DOWNLOAD_URL;
        a.download = 'StarCat Cosmetics.mcpack';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => btn.classList.remove('downloading'), 1200);
      });
    })();

    // ================== ELEMENTOS ==================
    const loadingScreen = document.getElementById('loadingScreen');
    const authScreen    = document.getElementById('authScreen');
    const setupNickScreen = document.getElementById('setupNickScreen');
    const menuScreen    = document.getElementById('menuScreen');
    const authTitle     = document.getElementById('authTitle');
    const authTabs      = document.querySelectorAll('.auth-tab');
    const authSubmit    = document.getElementById('authSubmit');
    const authMsg       = document.getElementById('authMsg');
    const emailInput    = document.getElementById('emailInput');
    const emailHint     = document.getElementById('emailHint');
    const passInput     = document.getElementById('passInput');
    const passHint      = document.getElementById('passHint');
    const pass2Field    = document.getElementById('pass2Field');
    const pass2Input    = document.getElementById('pass2Input');
    const pass2Hint     = document.getElementById('pass2Hint');
    const nickField     = document.getElementById('nickField');
    const signupNick    = document.getElementById('signupNick');
    const nickHint      = document.getElementById('nickHint');
    const captchaWrap   = document.getElementById('captchaWrap');
    const captchaCheck  = document.getElementById('captchaCheck');
    const captchaMath   = document.getElementById('captchaMath');
    const captchaAnswer = document.getElementById('captchaAnswer');
    const captchaHint   = document.getElementById('captchaHint');
    const captchaRefresh= document.getElementById('captchaRefresh');

    const setupNickInput = document.getElementById('setupNickInput');
    const setupNickHint  = document.getElementById('setupNickHint');
    const setupNickSave  = document.getElementById('setupNickSave');
    const setupNickMsg   = document.getElementById('setupNickMsg');
    const setupNickLogout= document.getElementById('setupNickLogout');

    const profileCorner     = document.getElementById('profileCorner');
    const profileAvatarBtn  = document.getElementById('profileAvatarBtn');
    const profileDropdown   = document.getElementById('profileDropdown');
    const profileHeadAvatar = document.getElementById('profileHeadAvatar');
    const profileHeadNick   = document.getElementById('profileHeadNick');
    const profileHeadEmail  = document.getElementById('profileHeadEmail');
    const profileLogoutBtn  = document.getElementById('profileLogoutBtn');

    const categoryTabs   = document.querySelectorAll('.category-tab');
    const wingsGrid      = document.getElementById('wingsGrid');
    const shieldsGrid    = document.getElementById('shieldsGrid');
    const headsGrid      = document.getElementById('headsGrid');
    const redeemArea     = document.getElementById('redeemArea');
    const previewInfo    = document.getElementById('previewInfo');
    const redeemInput    = document.getElementById('redeemInput');
    const redeemBtn      = document.getElementById('redeemBtn');

    const rewardOverlay  = document.getElementById('rewardOverlay');
    const rewardImg      = document.getElementById('rewardImg');
    const rewardName     = document.getElementById('rewardName');
    const rewardTitle    = document.getElementById('rewardTitle');
    const rewardSub      = document.getElementById('rewardSub');
    const rewardBtn      = document.getElementById('rewardBtn');

    const giftOverlay    = document.getElementById('giftOverlay');
    const giftConfetti   = document.getElementById('giftConfetti');
    const giftImg        = document.getElementById('giftImg');
    const giftItemName   = document.getElementById('giftItemName');
    const giftFrom       = document.getElementById('giftFrom');
    const giftSub        = document.getElementById('giftSub');
    const giftBtn        = document.getElementById('giftBtn');

    // ================== ESTADO ==================
    let currentUser = null;
    let playerNick = '';
    let selectedItem = null;
    let inventory = { costa: [], shield: ['shield_padrao'], head: [], items: [] };
    let mode = 'login';
    let captchaSolution = null;
    let captchaHumanChecked = false;
    let nickCheckTimer = null;
    let activeCategory = 'wings';
    let unsubscribeUserListener = null;
    let unsubscribeGiftsListener = null;
    let lastSeenGiftTimestamp = 0;
    let giftQueue = [];

    const NAMES = {
      wings_gold:       'Gold',
      wings_iron:       'Iron',
      wings_diamond:    'Diamond',
      wings_netherite:  'Netherite',
      wings_starcat:    'Starcat',
      wings_floral:     'Floral',
      shield_padrao:    'Padrão',
      shield_starcat:   'StarCat',
      shield_floral:    'Floral',
      head_coroa_flores:'Coroa de Flores'
    };

    // ================== HELPERS ==================
    function resolveSrc(btn) {
      if (!btn) return '';
      return btn.getAttribute('data-src') || btn.getAttribute('data-fallback') || '';
    }
    function resolveFallback(btn) {
      return btn?.getAttribute('data-fallback') || '';
    }
    function validNick(n) { n = n.trim(); return /^[A-Za-z0-9_ ]{3,20}$/.test(n); }
    function validEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e); }
    function validPass(p) { return p.length >= 6; }
    function cleanNick(n) { return n.trim().replace(/\s+/g, ' '); }
    function nickKey(n) { return n.toLowerCase().trim().replace(/\s+/g, ' '); }

    function setHint(el, msg, type) {
      el.textContent = msg || '';
      el.classList.remove('error', 'ok', 'checking');
      if (type) el.classList.add(type);
    }
    function initialsFromNick(nick) {
      if (!nick) return '?';
      const clean = nick.trim();
      if (!clean) return '?';
      const parts = clean.split(/\s+/);
      if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
      return clean.slice(0, 2).toUpperCase();
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    // ================== NICK NO DB ==================
    async function nickExistsInDB(nick, ignoreUid) {
      try {
        const key = nickKey(nick);
        const snap = await db.collection('nicks').doc(key).get();
        if (!snap.exists) return false;
        if (ignoreUid && snap.data().uid === ignoreUid) return false;
        return true;
      } catch (err) { return false; }
    }
    async function reserveNickInTransaction(tx, nick, uid) {
      const key = nickKey(nick);
      const nickRef = db.collection('nicks').doc(key);
      const nickSnap = await tx.get(nickRef);
      if (nickSnap.exists) {
        const data = nickSnap.data();
        if (data.uid !== uid) {
          const err = new Error('NICK_TAKEN'); err.code = 'NICK_TAKEN'; throw err;
        }
      } else {
        tx.set(nickRef, { uid, nick, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
      }
    }

    // ================== CONTADOR DE ITENS ==================
    let cachedCounts = null;
    let cachedCountsTime = 0;
    async function refreshItemCountsFromUsers() {
      try {
        const snap = await db.collection('users').get();
        const counts = {};
        snap.forEach(doc => {
          const d = doc.data();
          const groups = [
            Array.isArray(d.costa)  ? d.costa  : [],
            Array.isArray(d.shield) ? d.shield : [],
            Array.isArray(d.head)   ? d.head   : [],
            Array.isArray(d.items)  ? d.items  : []
          ];
          groups.forEach(arr => arr.forEach(itemId => {
            if (!itemId) return;
            counts[itemId] = (counts[itemId] || 0) + 1;
          }));
        });
        cachedCounts = counts;
        cachedCountsTime = Date.now();
        return counts;
      } catch (err) {
        return cachedCounts || {};
      }
    }
    async function updateOwnerCountsOnCards() {
      let counts;
      if (cachedCounts && Date.now() - cachedCountsTime < 5000) counts = cachedCounts;
      else counts = await refreshItemCountsFromUsers();

      document.querySelectorAll('.wing-btn, .shield-btn, .head-btn').forEach(btn => {
        const itemId = btn.getAttribute('data-item');
        if (!itemId) return;
        const old = btn.querySelector('.owner-count');
        if (old) old.remove();
        if (btn.classList.contains('locked')) return;
        const n = counts[itemId] || 0;
        const el = document.createElement('div');
        el.className = 'owner-count';
        el.textContent = n;
        el.title = `${n} ${n === 1 ? 'jogador tem' : 'jogadores têm'} este item`;
        btn.appendChild(el);
      });
    }
    function invalidateItemCountCache() { cachedCounts = null; cachedCountsTime = 0; }

    // ================== CAPTCHA ==================
    function newCaptcha() {
      const a = Math.floor(Math.random() * 9) + 2;
      const b = Math.floor(Math.random() * 9) + 2;
      const op = Math.random() < 0.5 ? '+' : '−';
      const result = op === '+' ? a + b : a - b;
      captchaSolution = result;
      captchaMath.innerHTML = `<span class="num">${a}</span> ${op} <span class="num">${b}</span> = `;
      captchaAnswer.value = '';
      captchaAnswer.classList.remove('invalid');
      captchaHint.textContent = 'Resolva a conta matemática';
      captchaHint.classList.remove('error', 'ok');
    }
    captchaRefresh.addEventListener('click', () => {
      newCaptcha(); captchaHumanChecked = false;
      captchaCheck.classList.remove('checked');
      captchaCheck.classList.add('shake');
      setTimeout(() => captchaCheck.classList.remove('shake'), 400);
    });
    captchaCheck.addEventListener('click', () => {
      captchaHumanChecked = !captchaHumanChecked;
      captchaCheck.classList.toggle('checked', captchaHumanChecked);
    });

    // ================== ABAS AUTH ==================
    authTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        mode = tab.dataset.tab;
        authTabs.forEach(t => t.classList.toggle('active', t === tab));
        const isSignup = mode === 'signup';
        authTitle.textContent = isSignup ? '✦ Criar Conta ✦' : '✦ Entrar ✦';
        authSubmit.textContent = isSignup ? 'Criar Conta' : 'Entrar';
        nickField.style.display = isSignup ? 'flex' : 'none';
        pass2Field.style.display = isSignup ? 'flex' : 'none';
        captchaWrap.style.display = isSignup ? 'flex' : 'none';
        if (isSignup) newCaptcha();
        authMsg.textContent = ''; authMsg.className = 'auth-msg';
      });
    });

    // ================== VALIDAÇÕES TEMPO REAL ==================
    signupNick.addEventListener('input', () => {
      const v = signupNick.value;
      if (!v.trim()) { setHint(nickHint, '3 a 20 caracteres. Letras, números, _ e espaços'); signupNick.classList.remove('invalid', 'valid'); return; }
      if (!validNick(v)) { setHint(nickHint, '✗ Use 3-20 chars: letras, números, _ e espaços', 'error'); signupNick.classList.add('invalid'); return; }
      signupNick.classList.remove('invalid');
      setHint(nickHint, 'Verificando disponibilidade...', 'checking');
      clearTimeout(nickCheckTimer);
      nickCheckTimer = setTimeout(async () => {
        const nick = cleanNick(v);
        const exists = await nickExistsInDB(nick);
        if (exists) { setHint(nickHint, '✗ Esse nick já está em uso', 'error'); signupNick.classList.add('invalid'); signupNick.classList.remove('valid'); }
        else { setHint(nickHint, '✓ Nick disponível', 'ok'); signupNick.classList.remove('invalid'); signupNick.classList.add('valid'); }
      }, 450);
    });
    emailInput.addEventListener('input', () => {
      const v = emailInput.value.trim();
      if (!v) { setHint(emailHint, ''); emailInput.classList.remove('invalid'); return; }
      if (validEmail(v)) { setHint(emailHint, '✓ E-mail válido', 'ok'); emailInput.classList.remove('invalid'); }
      else { setHint(emailHint, '✗ E-mail inválido', 'error'); emailInput.classList.add('invalid'); }
    });
    passInput.addEventListener('input', () => {
      const v = passInput.value;
      if (!v) { setHint(passHint, ''); passInput.classList.remove('invalid'); return; }
      if (validPass(v)) { setHint(passHint, '✓ Senha forte o suficiente', 'ok'); passInput.classList.remove('invalid'); }
      else { setHint(passHint, '✗ Mínimo 6 caracteres', 'error'); passInput.classList.add('invalid'); }
    });
    pass2Input.addEventListener('input', () => {
      const v = pass2Input.value;
      if (!v) { setHint(pass2Hint, ''); pass2Input.classList.remove('invalid'); return; }
      if (v === passInput.value) { setHint(pass2Hint, '✓ Senhas iguais', 'ok'); pass2Input.classList.remove('invalid'); }
      else { setHint(pass2Hint, '✗ As senhas não coincidem', 'error'); pass2Input.classList.add('invalid'); }
    });

    // ================== SUBMIT AUTH ==================
    authSubmit.addEventListener('click', async () => {
      authMsg.textContent = ''; authMsg.className = 'auth-msg';
      const email = emailInput.value.trim();
      const pass  = passInput.value;
      if (!validEmail(email)) { authMsg.textContent = 'Digite um e-mail válido.'; authMsg.classList.add('error'); return; }
      if (!validPass(pass))   { authMsg.textContent = 'Senha deve ter no mínimo 6 caracteres.'; authMsg.classList.add('error'); return; }
      authSubmit.disabled = true;
      try {
        if (mode === 'signup') {
          const nick = cleanNick(signupNick.value);
          const pass2 = pass2Input.value;
          if (!validNick(nick)) { authMsg.textContent = 'Nick inválido. 3-20 chars.'; authMsg.classList.add('error'); authSubmit.disabled = false; return; }
          if (pass !== pass2)   { authMsg.textContent = 'As senhas não coincidem.'; authMsg.classList.add('error'); authSubmit.disabled = false; return; }
          if (!captchaHumanChecked) {
            captchaCheck.classList.add('shake');
            setTimeout(() => captchaCheck.classList.remove('shake'), 400);
            authMsg.textContent = 'Marque a caixa "Não sou um robô".'; authMsg.classList.add('error'); authSubmit.disabled = false; return;
          }
          if (parseInt(captchaAnswer.value, 10) !== captchaSolution) {
            captchaAnswer.classList.add('invalid');
            authMsg.textContent = 'Resposta do captcha incorreta.'; authMsg.classList.add('error'); authSubmit.disabled = false;
            newCaptcha(); captchaHumanChecked = false; captchaCheck.classList.remove('checked'); return;
          }
          authMsg.textContent = 'Verificando nick...';
          const nickTaken = await nickExistsInDB(nick);
          if (nickTaken) { authMsg.textContent = 'Esse nick já está em uso.'; authMsg.classList.add('error'); authSubmit.disabled = false; return; }

          authMsg.textContent = 'Criando conta...';
          const cred = await auth.createUserWithEmailAndPassword(email, pass);
          const uid = cred.user.uid;
          try {
            await db.runTransaction(async (tx) => {
              await reserveNickInTransaction(tx, nick, uid);
              const userRef = db.collection('users').doc(uid);
              tx.set(userRef, {
                nick: nick, nickKey: nickKey(nick), email: email,
                costa:  ['wings_gold'],
                shield: ['shield_padrao'],
                head:   [],
                items:  [],
                firstLoginRewardSeen: false,
                createdAt: firebase.firestore.FieldValue.serverTimestamp(),
                updatedAt: firebase.firestore.FieldValue.serverTimestamp()
              });
            });
          } catch (txErr) {
            try { await cred.user.delete(); } catch (delErr) {}
            if (txErr.code === 'NICK_TAKEN') authMsg.textContent = 'Esse nick já está em uso.';
            else authMsg.textContent = 'Erro ao criar dados do usuário.';
            authMsg.className = 'auth-msg error';
            authSubmit.disabled = false;
            return;
          }
          invalidateItemCountCache();
          authMsg.textContent = '✓ Conta criada! Entrando...';
          authMsg.classList.add('success');
        } else {
          await auth.signInWithEmailAndPassword(email, pass);
          authMsg.textContent = '✓ Login efetuado!';
          authMsg.classList.add('success');
        }
      } catch (err) {
        console.error(err);
        const code = err.code || '';
        let msg = 'Erro: ' + (err.message || code);
        if (code === 'auth/email-already-in-use') msg = 'Esse e-mail já está cadastrado.';
        if (code === 'auth/invalid-email')        msg = 'E-mail inválido.';
        if (code === 'auth/weak-password')        msg = 'Senha muito fraca.';
        if (code === 'auth/user-not-found')       msg = 'Usuário não encontrado.';
        if (code === 'auth/wrong-password')       msg = 'Senha incorreta.';
        if (code === 'auth/invalid-credential')   msg = 'E-mail ou senha incorretos.';
        if (code === 'auth/too-many-requests')    msg = 'Muitas tentativas. Aguarde.';
        authMsg.textContent = msg;
        authMsg.className = 'auth-msg error';
      } finally {
        authSubmit.disabled = false;
      }
    });
    [emailInput, passInput, pass2Input, signupNick, captchaAnswer].forEach(inp => {
      inp.addEventListener('keydown', e => { if (e.key === 'Enter') authSubmit.click(); });
    });

    // ================== TELAS ==================
    function showScreen(name) {
      loadingScreen.classList.add('hidden');
      authScreen.classList.add('hidden');
      setupNickScreen.classList.add('hidden');
      menuScreen.classList.add('hidden');
      profileCorner.classList.add('hidden');
      if (name === 'loading') loadingScreen.classList.remove('hidden');
      if (name === 'auth')    authScreen.classList.remove('hidden');
      if (name === 'setupNick') setupNickScreen.classList.remove('hidden');
      if (name === 'menu') { menuScreen.classList.remove('hidden'); profileCorner.classList.remove('hidden'); }
    }

    // ================== PERFIL ==================
    function updateProfileUI() {
      const initials = initialsFromNick(playerNick);
      profileAvatarBtn.textContent = initials;
      profileHeadAvatar.textContent = initials;
      profileHeadNick.textContent = playerNick || '—';
      profileHeadEmail.textContent = currentUser?.email || '—';
    }
    profileAvatarBtn.addEventListener('click', (e) => { e.stopPropagation(); profileDropdown.classList.toggle('hidden'); });
    document.addEventListener('click', (e) => {
      if (!profileDropdown.classList.contains('hidden')) {
        if (!profileCorner.contains(e.target)) profileDropdown.classList.add('hidden');
      }
    });
    profileDropdown.addEventListener('click', (e) => e.stopPropagation());
    profileLogoutBtn.addEventListener('click', async () => { profileDropdown.classList.add('hidden'); await auth.signOut(); });

    // ================== SETUP NICK ==================
    setupNickInput.addEventListener('input', () => {
      const v = setupNickInput.value;
      if (!v.trim()) { setHint(setupNickHint, '3 a 20 caracteres.'); setupNickInput.classList.remove('invalid', 'valid'); return; }
      if (!validNick(v)) { setHint(setupNickHint, '✗ Use 3-20 chars.', 'error'); setupNickInput.classList.add('invalid'); return; }
      setupNickInput.classList.remove('invalid');
      setHint(setupNickHint, 'Verificando disponibilidade...', 'checking');
      clearTimeout(nickCheckTimer);
      nickCheckTimer = setTimeout(async () => {
        const nickClean = cleanNick(v);
        const exists = await nickExistsInDB(nickClean, currentUser?.uid);
        if (exists) { setHint(setupNickHint, '✗ Esse nick já está em uso', 'error'); setupNickInput.classList.add('invalid'); }
        else { setHint(setupNickHint, '✓ Nick disponível', 'ok'); setupNickInput.classList.add('valid'); }
      }, 450);
    });

    setupNickSave.addEventListener('click', async () => {
      setupNickMsg.textContent = ''; setupNickMsg.className = 'auth-msg';
      const newNick = cleanNick(setupNickInput.value);
      if (!validNick(newNick)) { setupNickMsg.textContent = 'Nick inválido.'; setupNickMsg.classList.add('error'); return; }
      if (!currentUser) return;
      setupNickSave.disabled = true;
      try {
        await db.runTransaction(async (tx) => {
          await reserveNickInTransaction(tx, newNick, currentUser.uid);
          const userRef = db.collection('users').doc(currentUser.uid);
          tx.set(userRef, {
            nick: newNick, nickKey: nickKey(newNick),
            costa:  ['wings_gold'],
            shield: ['shield_padrao'],
            head:   [],
            items:  [],
            updatedAt: firebase.firestore.FieldValue.serverTimestamp()
          }, { merge: true });
        });
        playerNick = newNick;
        updateProfileUI();
        invalidateItemCountCache();
        await loadInventoryAndShow();
      } catch (err) {
        if (err.code === 'NICK_TAKEN') setupNickMsg.textContent = 'Esse nick já está em uso.';
        else setupNickMsg.textContent = 'Erro ao salvar.';
        setupNickMsg.classList.add('error');
      } finally {
        setupNickSave.disabled = false;
      }
    });
    setupNickInput.addEventListener('keydown', e => { if (e.key === 'Enter') setupNickSave.click(); });
    setupNickLogout.addEventListener('click', async () => { await auth.signOut(); });

    // ================== CARREGAR INVENTÁRIO ==================
    async function loadInventoryAndShow() {
      try {
        const ref = db.collection('users').doc(currentUser.uid);
        const snap = await ref.get();
        if (snap.exists) {
          const data = snap.data();
          inventory.costa  = Array.isArray(data.costa)  ? data.costa  : [];
          inventory.shield = Array.isArray(data.shield) ? data.shield : [];
          inventory.head   = Array.isArray(data.head)   ? data.head   : [];
          inventory.items  = Array.isArray(data.items)  ? data.items  : [];
          if (!inventory.costa.includes('wings_gold')) {
            inventory.costa.push('wings_gold');
            await ref.set({ costa: inventory.costa }, { merge: true });
          }
          if (!inventory.shield.includes('shield_padrao')) {
            inventory.shield.push('shield_padrao');
            await ref.set({ shield: inventory.shield }, { merge: true });
          }
          const alreadySeen = data.firstLoginRewardSeen === true;
          if (!alreadySeen) {
            await ref.set({ firstLoginRewardSeen: true }, { merge: true });
            showRewardPopup('wings_gold', 'welcome');
          }
        } else {
          inventory.costa = ['wings_gold'];
          inventory.shield = ['shield_padrao'];
          inventory.head = [];
          inventory.items = [];
          await ref.set({
            nick: playerNick, nickKey: nickKey(playerNick), email: currentUser.email,
            costa: inventory.costa, shield: inventory.shield,
            head: inventory.head, items: inventory.items,
            firstLoginRewardSeen: true,
            createdAt: firebase.firestore.FieldValue.serverTimestamp(),
            updatedAt: firebase.firestore.FieldValue.serverTimestamp()
          });
          showRewardPopup('wings_gold', 'welcome');
        }
      } catch (err) {}
      invalidateItemCountCache();
      showScreen('menu');
      setupCosmeticButtons();
      reorderGrids();
      preloadAllFirstFrames();
      await updateOwnerCountsOnCards();
      listenForIncomingGifts();
    }

    // ================== POPUP DE RECOMPENSA ==================
    function showRewardPopup(itemId, mode = 'welcome') {
      const btn = document.querySelector(`[data-item="${itemId}"]`);
      const rawName = btn?.getAttribute('data-name') || NAMES[itemId] || itemId;
      const isWing = itemId.startsWith('wings_');
      rewardImg.src = '';
      rewardImg.className = isWing ? 'is-wing' : '';
      const local = resolveSrc(btn);
      const fallback = resolveFallback(btn);
      rewardImg.onerror = function () {
        if (fallback && this.src !== fallback) { this.onerror = null; this.src = fallback; }
      };
      rewardImg.src = local;
      if (mode === 'redeem') {
        rewardTitle.textContent = '✦ Resgatado ✦';
        rewardSub.textContent = 'você resgatou';
        rewardName.textContent = isWing ? rawName + ' Wings' : rawName;
      } else {
        rewardTitle.textContent = '✦ Recompensa ✦';
        rewardSub.textContent = 'primeiro login · boas-vindas';
        rewardName.textContent = isWing ? rawName + ' Wings' : rawName;
      }
      rewardOverlay.classList.add('show');
    }
    rewardBtn.addEventListener('click', () => { rewardOverlay.classList.remove('show'); });

    // ================== OBSERVER ==================
    auth.onAuthStateChanged(async (user) => {
      if (unsubscribeUserListener) { unsubscribeUserListener(); unsubscribeUserListener = null; }
      if (unsubscribeGiftsListener) { unsubscribeGiftsListener(); unsubscribeGiftsListener = null; }

      if (!user) {
        currentUser = null;
        playerNick = '';
        inventory = { costa: [], shield: ['shield_padrao'], head: [], items: [] };
        giftQueue = []; lastSeenGiftTimestamp = 0; hideGiftOverlay();
        showScreen('auth');
        return;
      }
      currentUser = user;
      showScreen('loading');

      let nickFromDB = '';
      try {
        const ref = db.collection('users').doc(user.uid);
        const snap = await ref.get();
        if (snap.exists) nickFromDB = snap.data().nick || '';
      } catch (err) {}

      if (!nickFromDB || !validNick(nickFromDB)) {
        playerNick = '';
        showScreen('setupNick');
        setupNickInput.value = '';
        setHint(setupNickHint, '3 a 20 caracteres.');
        return;
      }
      playerNick = nickFromDB;
      updateProfileUI();
      await loadInventoryAndShow();
    });

    // ================== SALVAR INVENTÁRIO ==================
    async function saveInventory() {
      if (!currentUser) return;
      try {
        await db.collection('users').doc(currentUser.uid).set({
          nick: playerNick, nickKey: nickKey(playerNick),
          costa: inventory.costa, shield: inventory.shield,
          head: inventory.head, items: inventory.items,
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        }, { merge: true });
        invalidateItemCountCache();
      } catch (err) {}
    }

    function isOwned(itemId) {
      if (itemId.startsWith('wings_')) return inventory.costa.includes(itemId);
      if (itemId.startsWith('shield_')) return inventory.shield.includes(itemId);
      if (itemId.startsWith('head_')) return inventory.head.includes(itemId);
      return inventory.items.includes(itemId);
    }

    // ================== BOTÕES ==================
    function setupCosmeticButtons() {
      document.querySelectorAll('.wing-btn, .shield-btn, .head-btn').forEach(btn => {
        const accent = btn.getAttribute('data-accent') || '#f87171';
        const glow = btn.getAttribute('data-accent-glow') || '#dc2626';
        btn.style.setProperty('--accent', accent);
        btn.style.setProperty('--accent-glow', glow);
        const itemId = btn.getAttribute('data-item');
        const owned = isOwned(itemId);
        btn.classList.toggle('locked', !owned);
        updateBtnLabel(btn, owned);
      });
      document.querySelectorAll('[data-floral-tag]').forEach(btn => {
        if (btn.querySelector('.floral-tag')) return;
        const tag = document.createElement('div');
        tag.className = 'floral-tag';
        const tagImg = new Image(); tagImg.src = FLORAL_TAG_ICON; tagImg.alt = 'Floral';
        tag.appendChild(tagImg);
        tag.addEventListener('click', (e) => { e.stopPropagation(); showBrandTooltip(e.currentTarget, 'Floral', 'floral'); });
        btn.appendChild(tag);
      });
      document.querySelectorAll('[data-starcat-tag]').forEach(btn => {
        if (btn.querySelector('.starcat-tag')) return;
        const tag = document.createElement('div');
        tag.className = 'starcat-tag';
        const tagImg = new Image(); tagImg.src = STARTCAT_TAG_ICON; tagImg.alt = 'StarCat';
        tag.appendChild(tagImg);
        tag.addEventListener('click', (e) => { e.stopPropagation(); showBrandTooltip(e.currentTarget, 'StarCat', 'starcat'); });
        btn.appendChild(tag);
      });
    }
    function updateBtnLabel(btn, owned) {
      const label = btn.querySelector('.label');
      if (!label) return;
      if (owned) label.textContent = btn.getAttribute('data-name') || 'Item';
      else label.textContent = '???';
    }
    function reorderGrids() {
      [wingsGrid, shieldsGrid, headsGrid].forEach(grid => {
        if (!grid) return;
        const children = Array.from(grid.children);
        const buttons = children.filter(c => c.matches('.wing-btn, .shield-btn, .head-btn'));
        const empties = children.filter(c => c.classList.contains('empty-cell'));
        const owned  = buttons.filter(b => !b.classList.contains('locked'));
        const locked = buttons.filter(b =>  b.classList.contains('locked'));
        grid.innerHTML = '';
        [...owned, ...locked, ...empties].forEach(el => grid.appendChild(el));
      });
    }
    function isLocked(btn) { return btn.classList.contains('locked'); }

    // ===== Apenas 1 GIF ativo (otimização) =====
    function preloadFirstFrame(btn) {
      if (!btn || btn.dataset.loaded === 'true') return;
      const local = resolveSrc(btn);
      const fallback = resolveFallback(btn);
      if (!local && !fallback) return;
      const img = new Image(); img.decoding = 'async';
      img.onload = () => {
        try {
          const size = 256;
          const canvas = document.createElement('canvas');
          canvas.width = size; canvas.height = size;
          const ctx = canvas.getContext('2d');
          const isWing = btn.classList.contains('wing-btn');
          const ratio = isWing
            ? Math.max(size / img.width, size / img.height)
            : Math.min(size / img.width, size / img.height) * 0.82;
          const w = img.width * ratio;
          const h = img.height * ratio;
          const x = (size - w) / 2;
          const y = (size - h) / 2;
          ctx.drawImage(img, x, y, w, h);
          const label = btn.querySelector('.label');
          const old = btn.querySelector('canvas');
          if (old) old.remove();
          btn.insertBefore(canvas, label);
          btn.dataset.loaded = 'true';
        } catch (e) {
          useStaticFallback(btn, local, fallback);
        }
      };
      img.onerror = () => {
        if (fallback && img.src !== fallback) { img.src = fallback; return; }
        btn.style.background = 'linear-gradient(135deg, #2a1414, #170808)';
      };
      img.src = local;
    }
    function useStaticFallback(btn, local, fallback) {
      if (btn.querySelector('img.static-frame')) return;
      const label = btn.querySelector('.label');
      const img = new Image();
      img.className = 'static-frame';
      img.decoding = 'async';
      img.onerror = function () {
        if (fallback && this.src !== fallback) { this.onerror = null; this.src = fallback; }
      };
      img.src = local || fallback;
      const old = btn.querySelector('canvas');
      if (old) old.remove();
      btn.insertBefore(img, label);
    }
    function preloadAllFirstFrames() {
      document.querySelectorAll('.wing-btn, .shield-btn, .head-btn').forEach(preloadFirstFrame);
    }

    // Só o botão clicado roda o GIF — os outros ficam em frame estático
    function activateGif(activeBtn) {
      document.querySelectorAll('.wing-btn, .shield-btn, .head-btn').forEach(btn => {
        const existingGif = btn.querySelector('img.gif-active');
        if (existingGif) existingGif.remove();
        const canvas = btn.querySelector('canvas');
        const staticFrame = btn.querySelector('img.static-frame');
        if (canvas) canvas.style.display = 'block';
        if (staticFrame) staticFrame.style.display = 'block';
      });
      if (!activeBtn) return;
      const local = resolveSrc(activeBtn);
      const fallback = resolveFallback(activeBtn);
      if (!local && !fallback) return;
      const canvas = activeBtn.querySelector('canvas');
      const staticFrame = activeBtn.querySelector('img.static-frame');
      if (canvas) canvas.style.display = 'none';
      if (staticFrame) staticFrame.style.display = 'none';
      const gif = new Image();
      gif.className = 'gif-active';
      gif.decoding = 'async';
      gif.alt = activeBtn.getAttribute('data-name') || '';
      gif.onerror = function () {
        if (fallback && this.src !== fallback) { this.onerror = null; this.src = fallback; }
      };
      gif.src = local;
      const label = activeBtn.querySelector('.label');
      activeBtn.insertBefore(gif, label);
    }

    // ================== TOOLTIP ==================
    let brandTooltipEl = null;
    function showBrandTooltip(anchorEl, text, variant) {
      if (!brandTooltipEl) {
        brandTooltipEl = document.createElement('div');
        brandTooltipEl.className = 'brand-tooltip';
        document.body.appendChild(brandTooltipEl);
      }
      brandTooltipEl.className = 'brand-tooltip ' + variant;
      brandTooltipEl.textContent = text;
      const rect = anchorEl.getBoundingClientRect();
      brandTooltipEl.classList.add('show');
      const tooltipRect = brandTooltipEl.getBoundingClientRect();
      const top = rect.top - tooltipRect.height - 8;
      const left = rect.left + rect.width / 2 - tooltipRect.width / 2;
      brandTooltipEl.style.top = Math.max(4, top) + 'px';
      brandTooltipEl.style.left = Math.max(4, Math.min(left, window.innerWidth - tooltipRect.width - 4)) + 'px';
      clearTimeout(brandTooltipEl._hideTimer);
      brandTooltipEl._hideTimer = setTimeout(() => brandTooltipEl.classList.remove('show'), 1500);
    }
    document.addEventListener('click', (e) => {
      if (brandTooltipEl && !e.target.closest('.floral-tag, .starcat-tag')) {
        brandTooltipEl.classList.remove('show');
      }
    });

    // ================== CATEGORIAS ==================
    categoryTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const cat = tab.dataset.category;
        activeCategory = cat;
        categoryTabs.forEach(t => t.classList.toggle('active', t === tab));
        wingsGrid.classList.add('hidden');
        shieldsGrid.classList.add('hidden');
        headsGrid.classList.add('hidden');
        if (cat === 'wings') wingsGrid.classList.remove('hidden');
        else if (cat === 'shields') shieldsGrid.classList.remove('hidden');
        else if (cat === 'heads') headsGrid.classList.remove('hidden');
        redeemArea.classList.remove('hidden');
        clearSelection();
        previewInfo.className = 'preview-info';
        previewInfo.textContent = 'Nenhum item selecionado';
        const activeGrid = cat === 'wings' ? wingsGrid : (cat === 'shields' ? shieldsGrid : headsGrid);
        activeGrid.querySelectorAll('.wing-btn, .shield-btn, .head-btn').forEach(preloadFirstFrame);
        updateOwnerCountsOnCards();
      });
    });
    function clearSelection() {
      document.querySelectorAll('.selected').forEach(b => b.classList.remove('selected'));
      activateGif(null);
      selectedItem = null;
    }

    // ================== SELEÇÃO ==================
    document.querySelectorAll('.wing-btn, .shield-btn, .head-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (e.target.closest('.floral-tag, .starcat-tag')) return;
        if (isLocked(btn)) return;
        const itemId = btn.getAttribute('data-item');
        const name = btn.getAttribute('data-name') || 'Item';
        const alreadySelected = btn.classList.contains('selected');
        clearSelection();
        if (alreadySelected) {
          previewInfo.className = 'preview-info';
          previewInfo.textContent = 'Nenhum item selecionado';
        } else {
          btn.classList.add('selected');
          activateGif(btn);
          selectedItem = { id: itemId, name, btn };
          previewInfo.className = 'preview-info';
          previewInfo.innerHTML = `Item selecionado: <strong>${name}</strong>`;
        }
      });
    });

    // ================== REDEEM ==================
    async function redeem() {
      const typed = redeemInput.value.trim().toUpperCase();
      if (!typed) { previewInfo.className = 'preview-info'; previewInfo.textContent = 'Digite um código para resgatar.'; return; }
      if (!currentUser) { previewInfo.className = 'preview-info error'; previewInfo.textContent = 'Você precisa estar logado.'; return; }
      redeemBtn.disabled = true;
      previewInfo.className = 'preview-info';
      previewInfo.textContent = 'Verificando código...';
      try {
        const codeRef = db.collection('codes').doc(typed);
        let matchedItem = null;
        await db.runTransaction(async (tx) => {
          const snap = await tx.get(codeRef);
          if (!snap.exists) { const e = new Error('INVALID'); e.code = 'INVALID'; throw e; }
          const data = snap.data();
          if (data.used) { const e = new Error('USED'); e.code = 'USED'; throw e; }
          if (data.expiresAt && typeof data.expiresAt.toDate === 'function') {
            if (data.expiresAt.toDate().getTime() < Date.now()) {
              const e = new Error('EXPIRED'); e.code = 'EXPIRED'; throw e;
            }
          }
          matchedItem = data.itemId;
          if (!matchedItem) { const e = new Error('INVALID'); e.code = 'INVALID'; throw e; }
          tx.update(codeRef, {
            used: true, usedBy: currentUser.uid,
            usedAt: firebase.firestore.FieldValue.serverTimestamp()
          });
        });
        let category, alreadyOwned;
        if (matchedItem.startsWith('wings_')) { category = 'costa'; alreadyOwned = inventory.costa.includes(matchedItem); }
        else if (matchedItem.startsWith('shield_')) { category = 'shield'; alreadyOwned = inventory.shield.includes(matchedItem); }
        else if (matchedItem.startsWith('head_')) { category = 'head'; alreadyOwned = inventory.head.includes(matchedItem); }
        else { category = 'items'; alreadyOwned = inventory.items.includes(matchedItem); }

        if (alreadyOwned) {
          previewInfo.className = 'preview-info';
          previewInfo.innerHTML = `ℹ️ Você já tem <strong>${NAMES[matchedItem] || matchedItem}</strong>.`;
          redeemInput.value = '';
          return;
        }
        inventory[category].push(matchedItem);
        await saveInventory();
        const btn = document.querySelector(`[data-item="${matchedItem}"]`);
        if (btn) {
          btn.classList.remove('locked');
          updateBtnLabel(btn, true);
          preloadFirstFrame(btn);
        }
        reorderGrids();
        await updateOwnerCountsOnCards();
        previewInfo.className = 'preview-info success';
        previewInfo.innerHTML = `✅ <strong>${NAMES[matchedItem] || matchedItem}</strong> desbloqueado!`;
        redeemInput.value = '';
        showRewardPopup(matchedItem, 'redeem');
      } catch (err) {
        previewInfo.className = 'preview-info error';
        if (err.code === 'INVALID')      previewInfo.innerHTML = '❌ Código inválido.';
        else if (err.code === 'USED')    previewInfo.innerHTML = '❌ Esse código já foi usado.';
        else if (err.code === 'EXPIRED') previewInfo.innerHTML = '❌ Esse código expirou.';
        else                             previewInfo.innerHTML = '❌ Erro ao resgatar código.';
      } finally {
        redeemBtn.disabled = false;
      }
    }
    redeemBtn.addEventListener('click', redeem);
    redeemInput.addEventListener('keydown', e => { if (e.key === 'Enter') redeem(); });
    redeemInput.addEventListener('input', () => {
      let v = redeemInput.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
      if (v.length > 19) v = v.slice(0, 19);
      redeemInput.value = v;
    });
    redeemInput.addEventListener('paste', (e) => {
      e.preventDefault();
      const txt = (e.clipboardData || window.clipboardData).getData('text') || '';
      let v = txt.toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 19);
      redeemInput.value = v;
    });

    // ================== DOAÇÃO ==================
    const donateToggleBtn    = document.getElementById('donateToggleBtn');
    const donateModalOverlay = document.getElementById('donateModalOverlay');
    const donateModalClose   = document.getElementById('donateModalClose');
    const donateStep1        = document.getElementById('donateStep1');
    const donateStep2        = document.getElementById('donateStep2');
    const donateMyItems      = document.getElementById('donateMyItems');
    const donatePreviewBox   = document.getElementById('donatePreviewBox');
    const donatePreviewThumb = document.getElementById('donatePreviewThumb');
    const donatePreviewName  = document.getElementById('donatePreviewName');
    const donatePreviewKind  = document.getElementById('donatePreviewKind');
    const donatePreviewItem  = document.getElementById('donatePreviewItem');
    const donateTargetNick   = document.getElementById('donateTargetNick');
    const donateNextBtn      = document.getElementById('donateNextBtn');
    const donateBackBtn      = document.getElementById('donateBackBtn');
    const donateConfirmBtn   = document.getElementById('donateConfirmBtn');
    const donateMsg1         = document.getElementById('donateMsg1');
    const donateMsg2         = document.getElementById('donateMsg2');
    const donateTargetAvatar = document.getElementById('donateTargetAvatar');
    const donateTargetNickLabel = document.getElementById('donateTargetNickLabel');

    let donateSelectedItem = null;
    let donateTargetUid = null;
    let donateTargetNickStr = '';

    function getMyOwnedItems() {
      const all = [];
      inventory.costa.forEach(id  => all.push({ id, kind: 'costa' }));
      inventory.shield.forEach(id => all.push({ id, kind: 'shield' }));
      inventory.head.forEach(id   => all.push({ id, kind: 'head' }));
      inventory.items.forEach(id  => all.push({ id, kind: 'items' }));
      return all;
    }
    function getKindLabel(kind) {
      return kind === 'costa' ? 'Asas' : kind === 'shield' ? 'Escudo' : kind === 'head' ? 'Cabeça' : 'Item';
    }
    function openDonateModal() {
      donateModalOverlay.classList.add('show');
      donateStep1.style.display = 'block';
      donateStep2.style.display = 'none';
      donateMsg1.textContent = ''; donateMsg1.className = 'search-msg';
      donateMsg2.textContent = ''; donateMsg2.className = 'search-msg';
      donateTargetNick.value = '';
      donateNextBtn.disabled = true;
      donateSelectedItem = null;
      donateTargetUid = null;
      donatePreviewBox.style.display = 'none';
      renderMyItemsForDonation();
      setTimeout(() => donateTargetNick.focus(), 100);
    }
    function renderMyItemsForDonation() {
      donateMyItems.innerHTML = '';
      const owned = getMyOwnedItems();
      if (owned.length === 0) {
        donateMyItems.innerHTML = '<div class="sr-empty" style="grid-column:1/-1;">Você não tem itens para doar</div>';
        return;
      }
      owned.forEach(({ id, kind }) => {
        const btn = document.querySelector(`[data-item="${id}"]`);
        const local = resolveSrc(btn);
        const fallback = resolveFallback(btn);
        const name = btn?.getAttribute('data-name') || NAMES[id] || id;

        const el = document.createElement('div');
        el.className = 'sr-item' + (kind === 'costa' ? ' wing' : '');

        const img = new Image();
        img.alt = name;
        img.loading = 'lazy';
        img.onerror = function () {
          if (fallback && this.src !== fallback) { this.onerror = null; this.src = fallback; }
        };
        img.src = local;
        el.appendChild(img);

        const label = document.createElement('span');
        label.className = 'sr-label';
        label.textContent = name;
        el.appendChild(label);

        el.addEventListener('click', () => {
          donateMyItems.querySelectorAll('.sr-item').forEach(x => {
            x.style.outline = 'none'; x.style.boxShadow = '';
          });
          el.style.outline = '3px solid #f87171';
          el.style.outlineOffset = '2px';
          el.style.boxShadow = '0 12px 24px -6px #dc2626';
          donateSelectedItem = { id, name, kind, local, fallback };
          showDonatePreview();
          updateDonateNextState();
        });
        donateMyItems.appendChild(el);
      });
    }
    function showDonatePreview() {
      if (!donateSelectedItem) { donatePreviewBox.style.display = 'none'; return; }
      donatePreviewBox.style.display = 'block';
      donatePreviewThumb.innerHTML = '';
      const img = new Image();
      img.alt = donateSelectedItem.name;
      img.style.width = donateSelectedItem.kind === 'costa' ? '100%' : '82%';
      img.style.height = donateSelectedItem.kind === 'costa' ? '100%' : '82%';
      img.style.objectFit = donateSelectedItem.kind === 'costa' ? 'cover' : 'contain';
      img.onerror = function () {
        if (donateSelectedItem.fallback && this.src !== donateSelectedItem.fallback) {
          this.onerror = null; this.src = donateSelectedItem.fallback;
        }
      };
      img.src = donateSelectedItem.local;
      donatePreviewThumb.appendChild(img);
      donatePreviewName.textContent = donateSelectedItem.name;
      donatePreviewKind.textContent = getKindLabel(donateSelectedItem.kind);
    }
    function updateDonateNextState() {
      const nickOk = donateTargetNick.value.trim().length >= 3;
      donateNextBtn.disabled = !(donateSelectedItem && nickOk);
    }
    donateTargetNick.addEventListener('input', updateDonateNextState);
    donateToggleBtn.addEventListener('click', openDonateModal);
    donateModalClose.addEventListener('click', () => donateModalOverlay.classList.remove('show'));
    donateModalOverlay.addEventListener('click', (e) => {
      if (e.target === donateModalOverlay) donateModalOverlay.classList.remove('show');
    });

    donateNextBtn.addEventListener('click', async () => {
      if (!donateSelectedItem) return;
      const query = cleanNick(donateTargetNick.value);
      if (!validNick(query)) { donateMsg1.textContent = 'Nick inválido (3-20 caracteres).'; donateMsg1.className = 'search-msg error'; return; }
      if (nickKey(query) === nickKey(playerNick)) { donateMsg1.textContent = 'Você não pode doar para si mesmo.'; donateMsg1.className = 'search-msg error'; return; }
      donateMsg1.textContent = 'Buscando jogador...'; donateMsg1.className = 'search-msg info';
      donateNextBtn.disabled = true;
      try {
        const nickSnap = await db.collection('nicks').doc(nickKey(query)).get();
        if (!nickSnap.exists) { donateMsg1.textContent = '❌ Jogador não encontrado.'; donateMsg1.className = 'search-msg error'; donateNextBtn.disabled = false; return; }
        const uid = nickSnap.data().uid;
        if (!uid || uid === currentUser.uid) { donateMsg1.textContent = '❌ Destinatário inválido.'; donateMsg1.className = 'search-msg error'; donateNextBtn.disabled = false; return; }
        const userSnap = await db.collection('users').doc(uid).get();
        if (!userSnap.exists) { donateMsg1.textContent = '❌ Perfil do destinatário não encontrado.'; donateMsg1.className = 'search-msg error'; donateNextBtn.disabled = false; return; }
        const targetData = userSnap.data();
        const targetNick = targetData.nick || query;
        donateTargetUid = uid;
        donateTargetNickStr = targetNick;
        donateTargetAvatar.textContent = initialsFromNick(targetNick);
        donateTargetNickLabel.textContent = targetNick;

        donatePreviewItem.innerHTML = '';
        const previewEl = document.createElement('div');
        previewEl.className = 'sr-item' + (donateSelectedItem.kind === 'costa' ? ' wing' : '');
        const prevImg = new Image();
        prevImg.alt = donateSelectedItem.name;
        prevImg.onerror = function () {
          if (donateSelectedItem.fallback && this.src !== donateSelectedItem.fallback) { this.onerror = null; this.src = donateSelectedItem.fallback; }
        };
        prevImg.src = donateSelectedItem.local;
        previewEl.appendChild(prevImg);
        const prevLabel = document.createElement('span');
        prevLabel.className = 'sr-label';
        prevLabel.textContent = donateSelectedItem.name;
        previewEl.appendChild(prevLabel);
        donatePreviewItem.appendChild(previewEl);

        donateStep1.style.display = 'none';
        donateStep2.style.display = 'block';
        donateMsg2.textContent = ''; donateMsg2.className = 'search-msg';
      } catch (err) {
        donateMsg1.textContent = '❌ Erro na busca.'; donateMsg1.className = 'search-msg error';
      } finally {
        donateNextBtn.disabled = false;
      }
    });

    donateBackBtn.addEventListener('click', () => {
      donateStep2.style.display = 'none';
      donateStep1.style.display = 'block';
    });

    donateConfirmBtn.addEventListener('click', async () => {
      if (!donateSelectedItem || !donateTargetUid) return;
      donateConfirmBtn.disabled = true;
      donateMsg2.textContent = 'Doando...'; donateMsg2.className = 'search-msg info';
      try {
        const cat = donateSelectedItem.kind;
        const itemId = donateSelectedItem.id;
        await db.runTransaction(async (tx) => {
          const myRef = db.collection('users').doc(currentUser.uid);
          const mySnap = await tx.get(myRef);
          if (!mySnap.exists) throw new Error('NO_USER');
          const myData = mySnap.data();
          const myArr = Array.isArray(myData[cat]) ? [...myData[cat]] : [];
          if (!myArr.includes(itemId)) throw new Error('NOT_OWNED');
          if (cat === 'shield' && itemId === 'shield_padrao') throw new Error('DEFAULT');
          tx.update(myRef, {
            [cat]: myArr.filter(x => x !== itemId),
            updatedAt: firebase.firestore.FieldValue.serverTimestamp()
          });
        });
        await db.collection('gifts').add({
          toUid: donateTargetUid,
          fromUid: currentUser.uid,
          fromNick: playerNick,
          itemId: itemId,
          category: cat,
          timestamp: firebase.firestore.FieldValue.serverTimestamp()
        });
        inventory[cat] = inventory[cat].filter(x => x !== itemId);
        invalidateItemCountCache();
        const btn = document.querySelector(`[data-item="${itemId}"]`);
        if (btn) { btn.classList.remove('selected'); btn.classList.add('locked'); updateBtnLabel(btn, false); }
        selectedItem = null;
        previewInfo.className = 'preview-info';
        previewInfo.textContent = 'Nenhum item selecionado';
        await updateOwnerCountsOnCards();
        donateMsg2.textContent = `✅ Você doou ${donateSelectedItem.name} para ${donateTargetNickStr}!`;
        donateMsg2.className = 'search-msg info';
        setTimeout(() => { donateModalOverlay.classList.remove('show'); }, 1400);
      } catch (err) {
        donateMsg2.className = 'search-msg error';
        if (err.message === 'NOT_OWNED')      donateMsg2.textContent = '❌ Você não possui mais esse item.';
        else if (err.message === 'DEFAULT')   donateMsg2.textContent = '❌ Esse item padrão não pode ser doado.';
        else if (err.message === 'NO_USER')   donateMsg2.textContent = '❌ Usuário não encontrado.';
        else                                  donateMsg2.textContent = '❌ Erro ao doar: ' + (err.message || 'desconhecido');
      } finally {
        donateConfirmBtn.disabled = false;
      }
    });

    // ================== GIFTS RECEBIDOS ==================
    function listenForIncomingGifts() {
      if (!currentUser) return;
      if (unsubscribeGiftsListener) { unsubscribeGiftsListener(); unsubscribeGiftsListener = null; }
      const myUid = currentUser.uid;
      const listenStart = Date.now();
      unsubscribeGiftsListener = db.collection('gifts')
        .where('toUid', '==', myUid)
        .onSnapshot(async (snap) => {
          const docs = [];
          snap.forEach(doc => docs.push({ id: doc.id, ...doc.data() }));
          docs.sort((a, b) => {
            const ta = a.timestamp?.toMillis ? a.timestamp.toMillis() : 0;
            const tb = b.timestamp?.toMillis ? b.timestamp.toMillis() : 0;
            return ta - tb;
          });
          for (const gift of docs) {
            const giftTs = gift.timestamp?.toMillis ? gift.timestamp.toMillis() : listenStart;
            if (giftTs <= lastSeenGiftTimestamp) continue;
            const itemId = gift.itemId;
            if (!itemId) continue;
            let cat;
            if (itemId.startsWith('wings_')) cat = 'costa';
            else if (itemId.startsWith('shield_')) cat = 'shield';
            else if (itemId.startsWith('head_')) cat = 'head';
            else cat = 'items';
            if (!inventory[cat].includes(itemId)) {
              inventory[cat].push(itemId);
              invalidateItemCountCache();
              try {
                await db.collection('users').doc(myUid).set({
                  [cat]: inventory[cat],
                  updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                }, { merge: true });
              } catch (e) {}
              const btn = document.querySelector(`[data-item="${itemId}"]`);
              if (btn) { btn.classList.remove('locked'); updateBtnLabel(btn, true); preloadFirstFrame(btn); }
              reorderGrids();
              updateOwnerCountsOnCards();
            }
            lastSeenGiftTimestamp = Math.max(lastSeenGiftTimestamp, giftTs);
            giftQueue.push({ itemId, fromNick: gift.fromNick || 'Alguém', timestamp: giftTs });
            processGiftQueue();
            try { await db.collection('gifts').doc(gift.id).delete(); } catch (e) {}
          }
        }, (err) => {});
    }
    function processGiftQueue() {
      if (giftOverlay.classList.contains('show')) return;
      if (giftQueue.length === 0) return;
      const next = giftQueue.shift();
      showGiftPopup(next);
    }
    function showGiftPopup(gift) {
      const itemId = gift.itemId;
      const btn = document.querySelector(`[data-item="${itemId}"]`);
      const name = btn?.getAttribute('data-name') || NAMES[itemId] || itemId;
      const isWing = itemId.startsWith('wings_');
      giftImg.src = ''; giftImg.className = isWing ? 'is-wing' : '';
      const local = resolveSrc(btn);
      const fallback = resolveFallback(btn);
      giftImg.onerror = function () {
        if (fallback && this.src !== fallback) { this.onerror = null; this.src = fallback; }
      };
      giftImg.src = local;
      giftItemName.textContent = isWing ? name + ' Wings' : name;
      giftFrom.innerHTML = `De <strong>${escapeHtml(gift.fromNick)}</strong>`;
      giftSub.textContent = 'você recebeu um presente!';
      giftConfetti.innerHTML = '';
      const colors = ['#4ade80', '#facc15', '#f87171', '#67e8f9', '#a855f7', '#f472b6'];
      for (let i = 0; i < 28; i++) {
        const span = document.createElement('span');
        span.style.position = 'absolute';
        span.style.top = '-20px';
        span.style.left = Math.random() * 100 + '%';
        span.style.background = colors[Math.floor(Math.random() * colors.length)];
        span.style.width = (6 + Math.random() * 8) + 'px';
        span.style.height = (6 + Math.random() * 8) + 'px';
        span.style.borderRadius = '2px';
        span.style.animation = `confettiFall ${2 + Math.random() * 2.5}s linear ${Math.random() * 1.5}s infinite`;
        giftConfetti.appendChild(span);
      }
      giftOverlay.classList.add('show');
      try { const s = clickSound.cloneNode(); s.volume = 0.7; s.play().catch(() => {}); } catch (e) {}
    }
    function hideGiftOverlay() {
      giftOverlay.classList.remove('show');
      giftConfetti.innerHTML = '';
    }
    giftBtn.addEventListener('click', () => { hideGiftOverlay(); setTimeout(processGiftQueue, 400); });

    // keyframes do confete — injetado
    (function injectConfettiKeyframes() {
      const style = document.createElement('style');
      style.textContent = `@keyframes confettiFall {
        0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
        100% { transform: translateY(600px) rotate(720deg); opacity: 0; }
      }`;
      document.head.appendChild(style);
    })();
  </script>
</body>
</html>
